{
  "manifest_version": 2,
  "name": "CODEX",
  "version": "0.3.0",
  "description": "Adds the email you are reading to your CODEX contexts, keyed by its Message-ID so it is found wherever it is filed.",
  "author": "X-Tech Laboratories",
  "homepage_url": "https://github.com/x-tech-laboratories/CODEX",
  "browser_specific_settings": {
    "gecko": { "id": "codex@x-tech-laboratories.github.io", "strict_min_version": "128.0" }
  },
  "icons": { "64": "icon-64.png" },
  "permissions": ["messagesRead", "storage"],
  "optional_permissions": ["<all_urls>"],
  "message_display_action": { "default_popup": "popup.html", "default_title": "Add to context", "default_icon": "icon-64.png" },
  "options_ui": { "page": "options.html" }
}
