{
  "name": "codex",
  "version": "0.3.0",
  "private": true,
  "description": "A personal knowledge base and assistant: contexts that gather tasks, notes, files, emails and links from the apps that keep them",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "CODEX_CONFIG=${CODEX_CONFIG:-config.example.json} CODEX_PASSWORD_HASH_FILE=${CODEX_PASSWORD_HASH_FILE:-password.hash} node --watch src/server/main.ts",
    "dev:web": "vite",
    "dev": "CODEX_USER_DATA=${CODEX_USER_DATA:-dev-data/desktop} electron-vite dev",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && electron-vite build",
    "start": "NODE_ENV=production node src/server/main.ts",
    "hash-password": "node src/server/hash_password.ts",
    "start:desktop": "electron-vite preview",
    "typecheck": "tsc -b",
    "db:generate": "for config in src/shared/*/drizzle.config.ts; do drizzle-kit generate --config \"$config\" && x-libs-bundle-migrations \"$(dirname \"$config\")/migrations\" || exit 1; done",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "seed": "node scripts/seed.ts",
    "icons": "node scripts/icons.ts",
    "build:thunderbird": "vite build -c vite.thunderbird.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.2",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@modelcontextprotocol/server": "^2.4.0",
    "@x-tech-laboratories/halon": "^0.33.0",
    "@x-tech-laboratories/x-libs": "^0.83.0",
    "fastify": "^5.12.8",
    "lucide-react": "^1.80.0",
    "openai": "^7.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "drizzle-kit": "1.0.0-rc.6",
    "electron": "^45.4.1",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
