{
    "extends": "./tsconfig.base.json",
    "include": ["electron.vite.config.ts", "vitest.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/core/**/*"],
    "exclude": ["src/**/*.test.ts"],
    "compilerOptions": {
        /* The core the main process imports still uses constructor parameter properties. */
        "erasableSyntaxOnly": false,
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2024"],
        "types": ["node", "electron-vite/node"]
    }
}
