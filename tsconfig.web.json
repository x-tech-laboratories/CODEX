{
    "extends": "./tsconfig.base.json",
    "include": ["src/web/**/*", "src/preload/index.d.ts", "src/shared/ipc.ts"],
    "exclude": ["src/**/*.test.ts"],
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["vite/client"]
    }
}
